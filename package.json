{
  "name": "procdeck-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter procdeck build",
    "dev": "pnpm --filter example dev",
    "check:types": "pnpm -r run check:types",
    "test": "pnpm -r --if-present run test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "oxfmt": "^0.56.0",
    "oxlint": "^1.67.0"
  },
  "packageManager": "pnpm@11.17.0"
}
