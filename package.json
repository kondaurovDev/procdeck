{
  "name": "procdeck-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter procdeck build",
    "dev": "pnpm --filter example dev",
    "check:types": "pnpm -r run check:types",
    "test": "pnpm -r --if-present run test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "changeset": "changeset",
    "prepare": "effect-tsgo patch"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@effect/tsgo": "^0.37.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.80.0"
  },
  "packageManager": "pnpm@11.17.0"
}
