{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["esnext", "dom", "dom.iterable"],
    // Relative imports carry explicit .ts extensions (vite resolves them;
    // tsc just needs to allow the syntax).
    "allowImportingTsExtensions": true
  },
  "include": ["src", "vite.config.ts"]
}
