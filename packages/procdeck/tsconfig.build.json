{
  // Declarations for the public entry point only — `defineConfig` and the
  // config types a `procdeck.config.ts` needs. The CLI has no type surface,
  // and `public.ts` deliberately references nothing from `config.ts`, so the
  // emitted declarations carry no dependency on effect.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/public.ts"]
}
